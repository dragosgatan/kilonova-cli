#!/usr/bin/env python3

import argparse
import datetime
import getpass
import json
import math
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

API_BASE = "https://kilonova.ro/api"
CONFIG_DIR = Path.home() / ".config" / "kn"
CONFIG_FILE = CONFIG_DIR / "config.json"
HISTORY_DIR = Path.home() / ".local" / "share" / "kn"
HISTORY_FILE = HISTORY_DIR / "submissions.jsonl"

LANG_EXT = {
    ".cpp": "cpp17",
    ".cc": "cpp17",
    ".cxx": "cpp17",
    ".c": "c",
    ".py": "python3",
    ".pas": "pascal",
}

FINISHED_STATUS = "finished"


# config

def load_config():
    if CONFIG_FILE.exists():
        try:
            return json.loads(CONFIG_FILE.read_text())
        except Exception:
            return {}
    return {}


def save_config(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(cfg))
    CONFIG_FILE.chmod(0o600)


# history

def _load_history():
    if not HISTORY_FILE.exists():
        return []
    records = []
    for line in HISTORY_FILE.read_text().splitlines():
        line = line.strip()
        if line:
            try:
                records.append(json.loads(line))
            except Exception:
                pass
    return records


def _append_history(record):
    HISTORY_DIR.mkdir(parents=True, exist_ok=True)
    with HISTORY_FILE.open("a") as f:
        f.write(json.dumps(record) + "\n")


def _record_submission(sub_id, problem_id, sub):
    subtests = sub.get("subtests") or []
    total = len(subtests)
    ok = sum(1 for t in subtests if t.get("verdict") == "translate:success")
    avg_time_ms = 0.0
    avg_mem_kb = 0.0
    if total:
        avg_time_ms = sum(t.get("time", 0) for t in subtests) / total * 1000
        avg_mem_kb = sum(t.get("memory", 0) for t in subtests) / total
    _append_history({
        "submission_id": sub_id,
        "problem_id": problem_id,
        "verdict": sub.get("icpc_verdict") or ("ac" if ok == total and total > 0 else "partial"),
        "score": sub.get("score", 0),
        "correct": ok,
        "wrong": total - ok,
        "avg_time_ms": round(avg_time_ms, 2),
        "avg_memory_kb": round(avg_mem_kb, 1),
        "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    })


# http helpers

def _build_multipart(fields, files):
    boundary = ("----KNBound" + str(int(time.time() * 1000))).encode()
    parts = []

    for name, value in fields.items():
        parts.append(
            b"--" + boundary + b"\r\n"
            b'Content-Disposition: form-data; name="' + name.encode() + b'"\r\n\r\n'
            + str(value).encode() + b"\r\n"
        )

    for name, (filename, data) in files.items():
        parts.append(
            b"--" + boundary + b"\r\n"
            b'Content-Disposition: form-data; name="' + name.encode()
            + b'"; filename="' + filename.encode() + b'"\r\n'
            b"Content-Type: application/octet-stream\r\n\r\n"
            + data + b"\r\n"
        )

    body = b"".join(parts) + b"--" + boundary + b"--\r\n"
    content_type = "multipart/form-data; boundary=" + boundary.decode()
    return body, content_type


def api_call(path, *, token=None, form=None, files=None, json_body=None, method=None):
    url = API_BASE + path
    headers = {"Authorization": token or "guest"}
    body = None

    if files is not None:
        body, ct = _build_multipart(form or {}, files)
        headers["Content-Type"] = ct
    elif form is not None:
        body = urllib.parse.urlencode(form).encode()
        headers["Content-Type"] = "application/x-www-form-urlencoded"
    elif json_body is not None:
        body = json.dumps(json_body).encode()
        headers["Content-Type"] = "application/json"

    http_method = method or ("POST" if body is not None else "GET")
    req = urllib.request.Request(url, data=body, headers=headers, method=http_method)

    try:
        with urllib.request.urlopen(req) as resp:
            result = json.loads(resp.read())
    except urllib.error.HTTPError as e:
        try:
            result = json.loads(e.read())
        except Exception:
            raise RuntimeError(f"HTTP {e.code}: {e.reason}")

    if result.get("status") == "error":
        raise RuntimeError(result.get("data", "unknown error"))

    return result.get("data")


# display

def _fmt_summary(subtests):
    total = len(subtests)
    if total == 0:
        return ""
    ok = sum(1 for t in subtests if t.get("verdict") == "translate:success")
    wrong = total - ok
    avg_time = sum(t.get("time", 0) for t in subtests) / total
    avg_mem = sum(t.get("memory", 0) for t in subtests) / total
    return (
        f"{ok} correct, {wrong} wrong  "
        f"avg time: {avg_time:.3f}s  avg memory: {avg_mem:.0f} KB"
    )


def print_submission(sub):
    if sub.get("compile_error"):
        print("compile error")
        msg = sub.get("compile_message") or ""
        if msg.strip():
            print(msg.rstrip())
        return

    score = sub.get("score", "?")
    icpc = sub.get("icpc_verdict")
    if icpc:
        print(f"verdict: {icpc}  score: {score}")
    else:
        print(f"score: {score}")

    subtests = sub.get("subtests") or []
    summary = _fmt_summary(subtests)
    if summary:
        print(summary)


def _get_submission(sub_id, token):
    return api_call(f"/submissions/getByID?id={sub_id}", token=token)


def _poll(sub_id, problem_id, token):
    start = time.time()
    while True:
        sub = _get_submission(sub_id, token)
        status = sub.get("status", "")
        if status == FINISHED_STATUS:
            print("\r" + " " * 30 + "\r", end="", flush=True)
            print_submission(sub)
            if not sub.get("compile_error"):
                _record_submission(sub_id, problem_id, sub)
            return
        elapsed = int(time.time() - start)
        print(f"\rwaiting... {elapsed}s", end="", flush=True)
        time.sleep(1)


# stats / trends helpers

def _ansi(text, code):
    return f"\033[{code}m{text}\033[0m"


def cmd_stats(_args):
    records = _load_history()
    if not records:
        print("no submissions recorded yet")
        return

    total = len(records)
    problems_seen = {}
    for r in records:
        pid = r["problem_id"]
        score = float(r.get("score", 0))
        ts = r.get("timestamp", "")
        if pid not in problems_seen:
            problems_seen[pid] = {"best": score, "attempts": 0, "first": ts}
        problems_seen[pid]["attempts"] += 1
        if score > problems_seen[pid]["best"]:
            problems_seen[pid]["best"] = score
        if ts < problems_seen[pid]["first"]:
            problems_seen[pid]["first"] = ts

    unique_problems = len(problems_seen)
    unique_acs = sum(1 for v in problems_seen.values() if v["best"] >= 100)
    ac_rate = unique_acs / unique_problems * 100 if unique_problems else 0

    print(f"total submissions : {total}")
    print(f"problems attempted: {unique_problems}")
    print(f"problems AC'd     : {unique_acs}")
    print(f"AC rate           : {ac_rate:.1f}%")


def cmd_history(_args):
    records = _load_history()
    if not records:
        print("no submissions recorded yet")
        return

    problems_seen = {}
    for r in records:
        pid = r["problem_id"]
        score = float(r.get("score", 0))
        ts = r.get("timestamp", "")
        if pid not in problems_seen:
            problems_seen[pid] = {"best": score, "attempts": 0, "first": ts}
        problems_seen[pid]["attempts"] += 1
        if score > problems_seen[pid]["best"]:
            problems_seen[pid]["best"] = score
        if ts < problems_seen[pid]["first"]:
            problems_seen[pid]["first"] = ts

    rows = [("problem", "best score", "attempts", "first seen")]
    for pid, v in sorted(problems_seen.items()):
        first = v["first"][:10] if v["first"] else "?"
        rows.append((str(pid), str(v["best"]), str(v["attempts"]), first))

    widths = [max(len(r[i]) for r in rows) for i in range(4)]
    sep = "  ".join("-" * w for w in widths)
    for i, row in enumerate(rows):
        print("  ".join(cell.ljust(w) for cell, w in zip(row, widths)))
        if i == 0:
            print(sep)


def cmd_trends(_args):
    records = _load_history()

    today = datetime.date.today()
    days = 30
    start = today - datetime.timedelta(days=days - 1)

    day_total = {}
    day_ac = {}
    for r in records:
        ts = r.get("timestamp", "")
        if not ts:
            continue
        try:
            d = datetime.date.fromisoformat(ts[:10])
        except ValueError:
            continue
        if d < start or d > today:
            continue
        day_total[d] = day_total.get(d, 0) + 1
        if r.get("correct", 0) > 0 and r.get("wrong", 0) == 0:
            day_ac[d] = day_ac.get(d, 0) + 1

    date_range = [start + datetime.timedelta(days=i) for i in range(days)]
    counts = [day_total.get(d, 0) for d in date_range]
    max_count = max(counts) if any(c > 0 for c in counts) else 1

    MAX_HEIGHT = 8
    BAR_WIDTH = 2

    for row in range(MAX_HEIGHT, 0, -1):
        if row in (MAX_HEIGHT, MAX_HEIGHT // 2, 1):
            y_label = f"{round(row * max_count / MAX_HEIGHT):2d}"
        else:
            y_label = "  "
        line = y_label + " │"
        for i, d in enumerate(date_range):
            n = counts[i]
            bar_rows = math.ceil(n * MAX_HEIGHT / max_count) if n > 0 else 0
            if row <= bar_rows:
                ch = "█" * BAR_WIDTH
                if day_ac.get(d, 0) > 0:
                    line += _ansi(ch, "32")
                else:
                    line += _ansi(ch, "31")
            else:
                line += " " * BAR_WIDTH
        print(line)

    print("   └" + "──" * days)

    label_chars = list(" " * (days * BAR_WIDTH))
    for i in range(0, days, 7):
        label = date_range[i].strftime("%-d %b")
        pos = i * BAR_WIDTH
        for j, c in enumerate(label):
            if pos + j < len(label_chars):
                label_chars[pos + j] = c
    print("    " + "".join(label_chars))
    print()

    all_active = sorted(d for d, n in day_total.items() if n > 0)

    current_streak = 0
    if all_active:
        d = today
        while d in day_total:
            current_streak += 1
            d -= datetime.timedelta(days=1)

    longest_streak = 0
    run = 0
    prev_d = None
    for d in all_active:
        if prev_d is not None and (d - prev_d).days == 1:
            run += 1
        else:
            run = 1
        longest_streak = max(longest_streak, run)
        prev_d = d

    most_active = max(day_total, key=lambda d: day_total[d]) if day_total else None

    print(f"current streak : {current_streak} day{'s' if current_streak != 1 else ''}")
    print(f"longest streak : {longest_streak} day{'s' if longest_streak != 1 else ''}")
    if most_active:
        print(f"most active day: {most_active}  ({day_total[most_active]} submissions)")


# commands

def cmd_login(_args):
    username = input("username: ")
    password = getpass.getpass("password: ")
    token = api_call("/auth/login", form={"username": username, "password": password})
    cfg = load_config()
    cfg["token"] = token
    save_config(cfg)
    print("logged in")


def cmd_logout(_args):
    cfg = load_config()
    token = cfg.get("token")
    if not token:
        print("not logged in", file=sys.stderr)
        sys.exit(1)
    api_call("/auth/logout", token=token)
    cfg.pop("token", None)
    save_config(cfg)
    print("logged out")


def cmd_submit(args):
    cfg = load_config()
    token = cfg.get("token")
    if not token:
        print("not logged in", file=sys.stderr)
        sys.exit(1)

    filepath = Path(args.file)
    if not filepath.exists():
        print(f"file not found: {args.file}", file=sys.stderr)
        sys.exit(1)

    if args.lang:
        lang = args.lang
    else:
        ext = filepath.suffix.lower()
        lang = LANG_EXT.get(ext)
        if not lang:
            print(f"cannot detect language from extension '{ext}'", file=sys.stderr)
            sys.exit(1)

    code = filepath.read_bytes()
    sub_id = api_call(
        "/submissions/submit",
        token=token,
        form={"language": lang, "problem_id": args.problem_id},
        files={"code": (filepath.name, code)},
    )

    print(f"submitted #{sub_id}")
    _poll(sub_id, args.problem_id, token)


def cmd_status(args):
    cfg = load_config()
    token = cfg.get("token")
    sub = _get_submission(args.submission_id, token)
    status = sub.get("status", "?")
    if status != FINISHED_STATUS:
        print(f"status: {status}")
    else:
        print_submission(sub)


# entry point
def main():
    parser = argparse.ArgumentParser(prog="kn", description="kilonova.ro CLI")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("login", help="authenticate and save session token")
    sub.add_parser("logout", help="invalidate session token")

    p_submit = sub.add_parser("submit", help="submit a solution")
    p_submit.add_argument("problem_id", type=int, metavar="problem_id")
    p_submit.add_argument("file", metavar="file")
    p_submit.add_argument("--lang", metavar="lang",
                          help="language id (c, cpp11, cpp14, cpp17, cpp20, python3, pascal, rust, java, ...)")

    p_status = sub.add_parser("status", help="show submission verdict")
    p_status.add_argument("submission_id", type=int, metavar="submission_id")

    sub.add_parser("stats", help="submission history statistics")
    sub.add_parser("history", help="per-problem breakdown (best score, attempts, first seen)")
    sub.add_parser("trends", help="bar chart of submissions over the last 30 days")

    args = parser.parse_args()

    dispatch = {
        "login": cmd_login,
        "logout": cmd_logout,
        "submit": cmd_submit,
        "status": cmd_status,
        "stats": cmd_stats,
        "history": cmd_history,
        "trends": cmd_trends,
    }

    try:
        dispatch[args.command](args)
    except RuntimeError as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print()
        sys.exit(130)


if __name__ == "__main__":
    main()
